datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_URL_TEST")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. Auth, Users & RBAC
// ==========================================

model User {
  id              BigInt        @id @default(autoincrement())
  email           String?       @unique(map: "idx_users_email") @db.VarChar(191)
  phone           String        @unique(map: "idx_users_phone") @db.VarChar(50)
  passwordHash    String        @db.VarChar(255)
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  avatarUrl       String?       @db.VarChar(500)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userRoles       UserRole[]
  addresses       Address[]
  vendor          Vendor?       @relation("VendorOwner")
  staffProfiles   VendorStaff[] @relation("StaffUser")
  managedStaff    VendorStaff[] @relation("StoreManagerStaff")
  priceHistories  ProductPriceHistory[]
  ordersPlaced    Order[]       @relation("CustomerOrders")
  agentOrders     Order[]       @relation("AgentOrders")
  managerOrders   Order[]       @relation("ManagerOrders")
  reviews         Review[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  importJobs      ImportJob[]
  exportJobs      ExportJob[]
  carts           Cart[]

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  slug        String           @unique(map: "idx_roles_slug") @db.VarChar(50)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique(map: "idx_permissions_key") @db.VarChar(100)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "idx_role_permission")
  @@map("role_permissions")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  roleId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "idx_user_role")
  @@map("user_roles")
}

// ==========================================
// 2. Multivendor & Staff Hierarchy
// ==========================================

model Vendor {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @unique(map: "idx_vendor_owner")
  storeName       String        @db.VarChar(150)
  slug            String        @unique(map: "idx_vendors_slug") @db.VarChar(150)
  description     String?       @db.Text
  logoUrl         String?       @db.VarChar(500)
  bannerUrl       String?       @db.VarChar(500)
  phone           String        @db.VarChar(50)
  email           String        @db.VarChar(191)
  whatsappNumber  String?       @db.VarChar(50)
  commissionRate  Decimal       @default(0.00) @db.Decimal(5, 2)
  status          String        @default("PENDING") @db.VarChar(30)
  balancePkr      Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner           User          @relation("VendorOwner", fields: [userId], references: [id], onDelete: Restrict)
  staff           VendorStaff[]
  products        Product[]
  subOrders       Order[]       @relation("VendorSubOrders")
  payouts         VendorPayout[]
  ledger          VendorLedger[]

  @@map("vendors")
}

model VendorStaff {
  id          BigInt   @id @default(autoincrement())
  vendorId    BigInt
  userId      BigInt
  roleType    String   @db.VarChar(30) // STORE_MANAGER, FIELD_AGENT
  managerId   BigInt?  // Field agent reports to a Store Manager (User ID)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user        User     @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  manager     User?    @relation("StoreManagerStaff", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([vendorId, userId, roleType], map: "idx_vendor_user_role")
  @@map("vendor_staff")
}

model VendorPayout {
  id              BigInt    @id @default(autoincrement())
  vendorId        BigInt
  amountPkr       Decimal   @db.Decimal(12, 2)
  status          String    @default("PENDING") @db.VarChar(30)
  paymentMethod   String    @db.VarChar(50)
  referenceNumber String?   @db.VarChar(100)
  note            String?   @db.Text
  requestedAt     DateTime  @default(now())
  processedAt     DateTime?

  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_payouts")
}

model VendorLedger {
  id              BigInt   @id @default(autoincrement())
  vendorId        BigInt
  orderId         BigInt?
  type            String   @db.VarChar(20) // CREDIT, DEBIT
  amountPkr       Decimal  @db.Decimal(12, 2)
  balanceAfterPkr Decimal  @db.Decimal(12, 2)
  description     String   @db.VarChar(255)
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_ledger")
}

model Address {
  id                 BigInt   @id @default(autoincrement())
  userId             BigInt
  label              String?  @db.VarChar(50)
  recipientName      String   @db.VarChar(100)
  phone              String   @db.VarChar(50)
  streetAddress      String   @db.Text
  city               String   @db.VarChar(100)
  province           String   @db.VarChar(100)
  postalCode         String?  @db.VarChar(20)
  isDefaultShipping  Boolean  @default(false)
  isDefaultBilling   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ==========================================
// 3. Catalog, Crops, Brands & Attributes
// ==========================================

model Category {
  id              Int       @id @default(autoincrement())
  nameEn          String    @db.VarChar(150)
  nameUr          String    @db.VarChar(150)
  slug            String    @unique(map: "idx_categories_slug") @db.VarChar(150)
  descriptionEn   String?   @db.Text
  descriptionUr   String?   @db.Text
  imageUrl        String?   @db.VarChar(500)
  iconUrl         String?   @db.VarChar(500)
  parentId        Int?
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent          Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryHierarchy")
  productCategories ProductCategory[]

  @@map("categories")
}

model Crop {
  id              Int       @id @default(autoincrement())
  nameEn          String    @db.VarChar(150)
  nameUr          String    @db.VarChar(150)
  slug            String    @unique(map: "idx_crops_slug") @db.VarChar(150)
  iconUrl         String?   @db.VarChar(500)
  imageUrl        String?   @db.VarChar(500)
  descriptionEn   String?   @db.Text
  descriptionUr   String?   @db.Text
  season          String    @default("ALL_SEASON") @db.VarChar(30)
  isPopular       Boolean   @default(false)
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  productCrops    ProductCrop[]

  @@map("crops")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  slug        String    @unique(map: "idx_brands_slug") @db.VarChar(150)
  logoUrl     String?   @db.VarChar(500)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("brands")
}

model Attribute {
  id          Int              @id @default(autoincrement())
  nameEn      String           @db.VarChar(100)
  nameUr      String           @db.VarChar(100)
  slug        String           @unique(map: "idx_attributes_slug") @db.VarChar(100)
  displayType String           @default("select") @db.VarChar(30)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  values      AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          Int       @id @default(autoincrement())
  attributeId Int
  valueEn     String    @db.VarChar(100)
  valueUr     String    @db.VarChar(100)
  colorCode   String?   @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@map("attribute_values")
}

// ==========================================
// 4. Products, Variations & Price History
// ==========================================

model Product {
  id                     BigInt    @id @default(autoincrement())
  vendorId               BigInt
  brandId                Int?
  nameEn                 String    @db.VarChar(255)
  nameUr                 String    @db.VarChar(255)
  slug                   String    @unique(map: "idx_products_slug") @db.VarChar(255)
  sku                    String    @unique(map: "idx_products_sku") @db.VarChar(100)
  productType            String    @default("SIMPLE") @db.VarChar(30) // SIMPLE, VARIABLE, GROUPED, BUNDLE
  status                 String    @default("PUBLISHED") @db.VarChar(30) // DRAFT, PENDING, PUBLISHED, ARCHIVED
  shortDescriptionEn     String?   @db.Text
  shortDescriptionUr     String?   @db.Text
  longDescriptionEn      String?   @db.LongText
  longDescriptionUr      String?   @db.LongText
  regularPrice           Decimal   @db.Decimal(10, 2)
  salePrice              Decimal?  @db.Decimal(10, 2)
  saleStart              DateTime?
  saleEnd                DateTime?
  costPrice              Decimal?  @db.Decimal(10, 2)
  stockQuantity          Int       @default(0)
  lowStockThreshold      Int       @default(5)
  manageStock            Boolean   @default(true)
  allowBackorders        Boolean   @default(false)
  weightKg               Decimal   @default(0.500) @db.Decimal(8, 3)
  lengthCm               Decimal?  @db.Decimal(8, 2)
  widthCm                Decimal?  @db.Decimal(8, 2)
  heightCm               Decimal?  @db.Decimal(8, 2)
  purchaseMode           String    @default("CART") @db.VarChar(30) // CART, WHATSAPP, CALL_FOR_PRICE, OUT_OF_STOCK
  whatsappNumberOverride String?   @db.VarChar(50)
  freeShipping           Boolean   @default(false)
  isFeatured             Boolean   @default(false)
  viewsCount             BigInt    @default(0)
  
  // Agri-specific attributes
  activeIngredient       String?   @db.VarChar(255)
  dosage                 String?   @db.VarChar(255)
  usageInstructionsEn    String?   @db.Text
  usageInstructionsUr    String?   @db.Text
  safetyPrecautionsEn    String?   @db.Text
  safetyPrecautionsUr    String?   @db.Text
  registrationDppNumber  String?   @db.VarChar(100)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  vendor                 Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  brand                  Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productCategories      ProductCategory[]
  productCrops           ProductCrop[]
  variations             ProductVariation[]
  images                 ProductImage[]
  priceHistories         ProductPriceHistory[]
  orderItems             OrderItem[]
  reviews                Review[]
  cartItems              CartItem[]

  @@index([vendorId], map: "idx_products_vendor")
  @@index([brandId], map: "idx_products_brand")
  @@index([status], map: "idx_products_status")
  @@fulltext([nameEn, nameUr, shortDescriptionEn, shortDescriptionUr], map: "idx_products_fulltext")
  @@map("products")
}

model ProductCategory {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt
  categoryId Int
  isPrimary  Boolean  @default(false)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId], map: "idx_product_category")
  @@map("product_categories")
}

model ProductCrop {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt
  cropId     Int
  cropStage  String?  @db.VarChar(50) // SOWING, VEGETATIVE, FLOWERING, HARVEST

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([productId, cropId], map: "idx_product_crop")
  @@map("product_crops")
}

model ProductVariation {
  id                   BigInt    @id @default(autoincrement())
  productId            BigInt
  sku                  String    @unique(map: "idx_variations_sku") @db.VarChar(100)
  regularPrice         Decimal   @db.Decimal(10, 2)
  salePrice            Decimal?  @db.Decimal(10, 2)
  stockQuantity        Int       @default(0)
  weightKg             Decimal   @db.Decimal(8, 3)
  attributesJson       Json
  imageUrl             String?   @db.VarChar(500)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]
  cartItems            CartItem[]

  @@map("product_variations")
}

model ProductImage {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt
  imageUrl     String   @db.VarChar(500)
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isThumbnail  Boolean  @default(false)
  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductPriceHistory {
  id                BigInt   @id @default(autoincrement())
  productId         BigInt
  oldRegularPrice   Decimal  @db.Decimal(10, 2)
  newRegularPrice   Decimal  @db.Decimal(10, 2)
  oldSalePrice      Decimal? @db.Decimal(10, 2)
  newSalePrice      Decimal? @db.Decimal(10, 2)
  changedByUserId   BigInt?
  reason            String?  @db.VarChar(255)
  createdAt         DateTime @default(now())

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedByUser     User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([productId], map: "idx_price_history_product")
  @@map("product_price_history")
}

// ==========================================
// 5. Carts & Orders (Price Snapshots)
// ==========================================

model Cart {
  id           BigInt     @id @default(autoincrement())
  userId       BigInt?
  sessionToken String?    @db.VarChar(191)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id          BigInt            @id @default(autoincrement())
  cartId      BigInt
  productId   BigInt
  variationId BigInt?
  quantity    Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  cart        Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@map("cart_items")
}

model Order {
  id                 BigInt     @id @default(autoincrement())
  orderNumber        String     @unique(map: "idx_orders_number") @db.VarChar(50)
  parentOrderId      BigInt?    // Null for customer parent order; references parent for vendor sub-orders
  isSubOrder         Boolean    @default(false)
  vendorId           BigInt?    // Assigned on sub-orders
  
  customerId         BigInt?
  customerName       String     @db.VarChar(150)
  customerPhone      String     @db.VarChar(50)
  customerEmail      String?    @db.VarChar(191)
  shippingAddressJson Json
  billingAddressJson  Json?

  status             String     @default("PENDING") @db.VarChar(30)
  paymentStatus      String     @default("PENDING") @db.VarChar(30)
  paymentMethod      String     @default("COD") @db.VarChar(30)
  
  subtotalPkr        Decimal    @db.Decimal(12, 2)
  discountPkr        Decimal    @default(0.00) @db.Decimal(12, 2)
  taxPkr             Decimal    @default(0.00) @db.Decimal(12, 2)
  shippingChargePkr  Decimal    @default(0.00) @db.Decimal(12, 2)
  totalPkr           Decimal    @db.Decimal(12, 2)
  totalWeightKg      Decimal    @db.Decimal(8, 3)

  shippingMethod     String     @default("STANDARD_WEIGHT_TIER") @db.VarChar(50)
  shippingReason     String     @default("STANDARD") @db.VarChar(100) // STANDARD, FIELD_AGENT_OVERRIDE, FREE_SHIPPING_PRODUCT, COUPON

  // Staff / Field Agent hierarchy tracking
  placedByAgentId    BigInt?
  storeManagerId     BigInt?

  customerNote       String?    @db.Text
  adminNote          String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  customer           User?      @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  agent              User?      @relation("AgentOrders", fields: [placedByAgentId], references: [id], onDelete: SetNull)
  manager            User?      @relation("ManagerOrders", fields: [storeManagerId], references: [id], onDelete: SetNull)
  vendor             Vendor?    @relation("VendorSubOrders", fields: [vendorId], references: [id], onDelete: SetNull)
  parentOrder        Order?     @relation("SubOrdersRelation", fields: [parentOrderId], references: [id], onDelete: Cascade)
  subOrders          Order[]    @relation("SubOrdersRelation")

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  notes              OrderNote[]
  shipments          Shipment[]
  payments           Payment[]
  refunds            Refund[]

  @@index([customerId], map: "idx_orders_customer")
  @@index([placedByAgentId], map: "idx_orders_agent")
  @@index([storeManagerId], map: "idx_orders_manager")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id                             BigInt            @id @default(autoincrement())
  orderId                        BigInt
  productId                      BigInt
  variationId                    BigInt?
  vendorId                       BigInt

  // Permanent immutable snapshot at time of purchase
  productNameSnapshot            String            @db.VarChar(255)
  skuSnapshot                    String            @db.VarChar(100)
  imageUrlSnapshot               String?           @db.VarChar(500)
  unitPricePaidSnapshot          Decimal           @db.Decimal(10, 2)
  regularPriceSnapshot           Decimal           @db.Decimal(10, 2)
  discountSnapshot               Decimal           @default(0.00) @db.Decimal(10, 2)
  taxSnapshot                    Decimal           @default(0.00) @db.Decimal(10, 2)
  itemWeightKgSnapshot           Decimal           @db.Decimal(8, 3)
  quantity                       Int               @default(1)
  variationAttributesSnapshot    Json?

  createdAt                      DateTime          @default(now())

  order                          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variation                      ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

model OrderStatusHistory {
  id             BigInt   @id @default(autoincrement())
  orderId        BigInt
  previousStatus String?  @db.VarChar(30)
  newStatus      String   @db.VarChar(30)
  changedByUserId BigInt?
  comment        String?  @db.VarChar(255)
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model OrderNote {
  id                BigInt   @id @default(autoincrement())
  orderId           BigInt
  authorUserId      BigInt?
  isCustomerVisible Boolean  @default(false)
  note              String   @db.Text
  createdAt         DateTime @default(now())

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_notes")
}

model Shipment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt
  carrier        String    @db.VarChar(100)
  trackingNumber String?   @db.VarChar(100)
  trackingUrl    String?   @db.VarChar(500)
  status         String    @default("LABEL_CREATED") @db.VarChar(50)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

// ==========================================
// 6. Weight-Based Shipping Rules Engine
// ==========================================

model ShippingRule {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  minWeightKg   Decimal  @db.Decimal(8, 3)
  maxWeightKg   Decimal? @db.Decimal(8, 3) // Null means over 30kg (unbounded)
  flatChargePkr Decimal  @db.Decimal(10, 2)
  perKgRatePkr  Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("shipping_rules")
}

// ==========================================
// 7. Payments, Refunds & Coupons
// ==========================================

model Payment {
  id                   BigInt   @id @default(autoincrement())
  orderId              BigInt
  method               String   @db.VarChar(50)
  gatewayTransactionId String?  @db.VarChar(150)
  amountPkr            Decimal  @db.Decimal(12, 2)
  status               String   @default("PENDING") @db.VarChar(30)
  rawResponseJson      Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Refund {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt
  amountPkr       Decimal  @db.Decimal(12, 2)
  reason          String?  @db.Text
  status          String   @default("PENDING") @db.VarChar(30)
  approvedByUserId BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Coupon {
  id               Int       @id @default(autoincrement())
  code             String    @unique(map: "idx_coupons_code") @db.VarChar(50)
  discountType     String    @default("PERCENT") @db.VarChar(20) // PERCENT, FIXED
  discountAmount   Decimal   @db.Decimal(10, 2)
  minOrderAmount   Decimal?  @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)
  freeShipping     Boolean   @default(false)
  expiryDate       DateTime?
  usageLimit       Int?
  timesUsed        Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("coupons")
}

model Review {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  userId    BigInt
  rating    Int      @default(5)
  title     String?  @db.VarChar(150)
  comment   String   @db.Text
  status    String   @default("APPROVED") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ==========================================
// 8. Super Admin CMS Engine
// ==========================================

model CmsMenu {
  id        Int           @id @default(autoincrement())
  title     String        @db.VarChar(100)
  location  String        @unique(map: "idx_menus_location") @db.VarChar(50)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items     CmsMenuItem[]

  @@map("cms_menus")
}

model CmsMenuItem {
  id           Int           @id @default(autoincrement())
  menuId       Int
  parentId     Int?
  titleEn      String        @db.VarChar(100)
  titleUr      String        @db.VarChar(100)
  url          String        @db.VarChar(500)
  linkType     String        @default("CUSTOM") @db.VarChar(30)
  targetBlank  Boolean       @default(false)
  icon         String?       @db.VarChar(100)
  badgeText    String?       @db.VarChar(50)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  menu         CmsMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       CmsMenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     CmsMenuItem[] @relation("MenuHierarchy")

  @@map("cms_menu_items")
}

model CmsBlock {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(150)
  blockKey     String   @unique(map: "idx_blocks_key") @db.VarChar(100)
  blockType    String   @db.VarChar(50)
  configJson   Json
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cms_blocks")
}

model CmsPage {
  id              Int      @id @default(autoincrement())
  titleEn         String   @db.VarChar(200)
  titleUr         String   @db.VarChar(200)
  slug            String   @unique(map: "idx_pages_slug") @db.VarChar(200)
  contentEn       String   @db.LongText
  contentUr       String   @db.LongText
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.VarChar(500)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cms_pages")
}

model Banner {
  id              Int       @id @default(autoincrement())
  titleEn         String    @db.VarChar(200)
  titleUr         String    @db.VarChar(200)
  subtitleEn      String?   @db.VarChar(255)
  subtitleUr      String?   @db.VarChar(255)
  ctaTextEn       String?   @db.VarChar(100)
  ctaTextUr       String?   @db.VarChar(100)
  ctaUrl          String?   @db.VarChar(500)
  desktopImageUrl String    @db.VarChar(500)
  mobileImageUrl  String?   @db.VarChar(500)
  startDate       DateTime?
  endDate         DateTime?
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("banners")
}

model SiteSetting {
  id               Int      @id @default(autoincrement())
  settingKey       String   @unique(map: "idx_settings_key") @db.VarChar(100)
  settingValueJson Json
  description      String?  @db.VarChar(255)
  isPublic         Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

// ==========================================
// 9. Jobs, Queue Engine & Audit
// ==========================================

model Job {
  id          BigInt    @id @default(autoincrement())
  queueName   String    @default("default") @db.VarChar(50)
  jobType     String    @db.VarChar(100)
  payloadJson Json
  status      String    @default("PENDING") @db.VarChar(30) // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  errorLog    String?   @db.Text
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt], map: "idx_jobs_status_runat")
  @@map("jobs")
}

model ImportJob {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt
  entityType       String   @db.VarChar(50)
  filePath         String   @db.VarChar(500)
  status           String   @default("PENDING") @db.VarChar(30)
  totalRows        Int      @default(0)
  processedRows    Int      @default(0)
  failedRows       Int      @default(0)
  errorReportPath  String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("import_jobs")
}

model ExportJob {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt
  exportType       String   @db.VarChar(50)
  filterParamsJson Json
  status           String   @default("PENDING") @db.VarChar(30)
  fileUrl          String?  @db.VarChar(500)
  rowCount         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  type      String   @db.VarChar(50)
  titleEn   String   @db.VarChar(200)
  titleUr   String   @db.VarChar(200)
  messageEn String   @db.Text
  messageUr String   @db.Text
  linkUrl   String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt?
  action        String   @db.VarChar(100)
  entityType    String   @db.VarChar(100)
  entityId      String?  @db.VarChar(100)
  oldValuesJson Json?
  newValuesJson Json?
  ipAddress     String?  @db.VarChar(50)
  userAgent     String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}
