# ==============================================
# GrowPak Store - Environment Configuration Template
# ==============================================

# Application Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api/v1
APP_URL=http://localhost:4200
ADMIN_URL=http://localhost:4300

# Database Configuration (MySQL 8 - Native)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=growpak_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=growpak_store
DB_NAME_TEST=growpak_store_test

# Prisma Connection URL
DATABASE_URL="mysql://growpak_user:your_secure_db_password_here@127.0.0.1:3306/growpak_store"
DATABASE_URL_TEST="mysql://growpak_user:your_secure_db_password_here@127.0.0.1:3306/growpak_store_test"

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Optional Redis & Queue (Leave blank for in-process DB-backed queue and in-memory cache)
REDIS_URL=

# Media Storage (local disk storage default)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Contact & WhatsApp Integration
DEFAULT_WHATSAPP_NUMBER=+923260409887
SUPPORT_EMAIL=info@growtechsol.com
SUPPORT_PHONE=+923260409887

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="GrowPak Store <noreply@growpak.store>"

# CORS and Security
CORS_ORIGINS="http://localhost:4200,http://localhost:4300"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
